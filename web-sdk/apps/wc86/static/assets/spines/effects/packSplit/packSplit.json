{
  "name": "packSplit",
  "description": "Alpha wolf duplication effect",
  "animations": {
    "split": {
      "type": "split_effect",
      "duration": 800,
      "loop": false,
      "keyframes": [
        {
          "time": 0,
          "scale": 1.0,
          "flash": false
        },
        {
          "time": 0.2,
          "scale": 1.3,
          "flash": true,
          "shake": 5
        },
        {
          "time": 0.4,
          "scale": 1.0,
          "split_start": true
        },
        {
          "time": 0.7,
          "spread": 80,
          "opacity": 1
        },
        {
          "time": 1.0,
          "spread": 100,
          "opacity": 1
        }
      ]
    },
    "duplicate": {
      "type": "clone_appear",
      "duration": 400,
      "loop": false,
      "keyframes": [
        {
          "time": 0,
          "scale": 0,
          "opacity": 0
        },
        {
          "time": 0.3,
          "scale": 1.2,
          "opacity": 0.8
        },
        {
          "time": 0.6,
          "scale": 0.95,
          "opacity": 1
        },
        {
          "time": 1.0,
          "scale": 1.0,
          "opacity": 1
        }
      ]
    }
  }
}