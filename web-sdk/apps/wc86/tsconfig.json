{
	"extends": "config-ts/base.json",
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"paths": {
			"$game/*": ["./src/game/*"],
			"$components/*": ["./src/components/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
